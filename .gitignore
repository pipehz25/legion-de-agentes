# Ejecutables compartidos y modelo de transcripcion: se instalan con herramientas/instalar.ps1
herramientas/bin/
herramientas/modelos/

# Instantaneas crudas de cada ciclo del Cazador Viral: se regeneran y pesan mucho con el tiempo
datos/*/crudo/

# Cache de transcripciones del Clipero: contenido de terceros, se regenera con `analizar`
datos/clipero/fuentes/

# Video e imagenes de los clips (solo se versiona meta.json) y su carpeta temporal
salidas/clipero/clips/**/*.mp4
salidas/clipero/clips/**/*.jpg
salidas/**/trabajo/

# Lo mismo dentro de cada espacio (espacios/<nombre>/ tiene sus propios datos y salidas)
espacios/*/datos/*/crudo/
espacios/*/datos/clipero/fuentes/
espacios/*/salidas/clipero/clips/**/*.mp4
espacios/*/salidas/clipero/clips/**/*.jpg
espacios/*/salidas/**/trabajo/
espacios/*/datos/publicador/envios/*.enviando

# En que espacio trabaja esta PC: cada PC tiene el suyo
espacio.local.json

# Configuracion personal de Claude Code
.claude/settings.local.json

# Marca de subida en curso del Publicador: solo sobrevive si una subida se corta a medias
datos/publicador/envios/*.enviando

# Credenciales que alguien deje por error en el proyecto (las del Publicador viven en %USERPROFILE%\.legion)
*.env
cookies*.txt
credenciales*.json
