# Ejecutables compartidos: se instalan con herramientas/instalar.ps1
herramientas/bin/

# Instantaneas crudas de cada ciclo del Cazador Viral: se regeneran y pesan mucho con el tiempo
datos/*/crudo/

# Cache de transcripciones del Clipero: contenido de terceros, se regenera con `analizar`
datos/clipero/fuentes/

# Video e imagenes de los clips (solo se versiona meta.json) y su carpeta temporal
salidas/clipero/clips/**/*.mp4
salidas/clipero/clips/**/*.jpg
salidas/**/trabajo/

# Configuracion personal de Claude Code
.claude/settings.local.json

# Credenciales que alguien deje por error en el proyecto
*.env
cookies*.txt
