  "fuentes": [
    {
      "dato": "Panamá se independizó de España el 28 de noviembre de 1821 y se unió a la Gran Colombia",
      "fuente": "Library of Congress, Country Study: Panama, «Independence from Spain»",
      "url": "https://countrystudies.us/panama/4.htm"
    },
    {
      "dato": "Panamá se independizó de España el 28 de noviembre de 1821 y se unió a la Gran Colombia",
      "fuente": "La Estrella de Panamá, «La independencia de Panamá de España en el contexto regional»",
      "url": "https://www.laestrella.com.pa/nacional/211126/independencia-panama-espana-contexto-regional"
    },
    {
      "dato": "El ferrocarril de Panamá, de una empresa formada en Nueva York, hizo su primer viaje de océano a océano en enero de 1855",
      "fuente": "Library of Congress, Country Study: Panama, «The California Gold Rush and the Panama Railroad»",
      "url": "https://countrystudies.us/panama/5.htm"
    },
    {
      "dato": "El ferrocarril de Panamá se terminó en enero de 1855",
      "fuente": "Linda Hall Library, «The Land Divided, the World United»: Panama Railroad",
      "url": "https://www.lindahall.org/experience/digital-exhibitions/the-land-divided-the-world-united/05-panama-railroad"
    },
    {
      "dato": "Los franceses empezaron en 1880; tras unos 9 años y cerca de 20.000 muertes, el proyecto quebró; el Senado de EE. UU. votó por Panamá el 19 de junio de 1902; Roosevelt envió buques; la separación fue el 3 de noviembre de 1903",
      "fuente": "U.S. Department of State, Office of the Historian, «Building the Panama Canal, 1903-1914»",
      "url": "https://history.state.gov/milestones/1899-1913/panama-canal"
    },
    {
      "dato": "Bunau-Varilla, ingeniero francés que había trabajado en el canal, recibió a Amador en Nueva York; le prometió dinero y respaldo estadounidense, le dio bandera, declaración y constitución, y exigió ser ministro en Washington; el 3 de noviembre llegó el batallón Tiradores a Colón; el general Tobar fue llevado a Ciudad de Panamá por el ferrocarril y arrestado; el Bogotá disparó y mató a un residente chino; el 5 de noviembre las tropas se fueron; el 6 hubo reconocimiento; el 18 Hay y Bunau-Varilla firmaron antes de que llegaran Amador y Boyd; zona de diez millas a perpetuidad, mismos 10 millones y 250.000 al año",
      "fuente": "American Heritage, «The Strange Affair of Taking the Panama Canal Zone»",
      "url": "https://www.americanheritage.com/strange-affair-taking-panama-canal-zone"
    },
    {
      "dato": "El Nashville llegó a Colón el 2 de noviembre de 1903 para impedir el avance de las tropas colombianas por el ferrocarril",
      "fuente": "Hampton Roads Naval Museum (U.S. Navy), «USS Nashville (PG-7) and the building of the Panama Canal»",
      "url": "https://hamptonroadsnavalmuseum.blogspot.com/2015/09/uss-nashville-pg-7-and-building-of.html"
    },
    {
      "dato": "El 4 de noviembre de 1903, el comandante Hubbard del Nashville informó al coronel Torres que había ordenado al ferrocarril dejar de transportar tropas",
      "fuente": "Theodore Roosevelt Center, carta de John Hubbard a Eliseo Torres, 4 de noviembre de 1903",
      "url": "https://www.theodorerooseveltcenter.org/digital-library/o42639"
    },
    {
      "dato": "Esteban Huertas, jefe militar en Panamá, hizo arrestar al general Tobar y a sus oficiales el 3 de noviembre; con la noticia, los revolucionarios proclamaron la independencia",
      "fuente": "Juan Manuel Pérez, «Huertas, Esteban (1876-1943)», Encyclopedia of Latin American History and Culture (Encyclopedia.com)",
      "url": "https://encyclopedia.com/humanities/encyclopedias-almanacs-transcripts-and-maps/huertas-esteban-1876-1943"
    },
    {
      "dato": "El ferrocarril, manejado por estadounidenses, se negó a llevar a las tropas colombianas; en pocos días volvieron; EE. UU. reconoció a Panamá el 6 de noviembre; en 1911, en Berkeley, Roosevelt dijo que había «tomado» el istmo y dejado al Congreso debatiendo",
      "fuente": "Theodore Roosevelt Presidential Library, «The Panama Canal»",
      "url": "https://www.trlibrary.com/tr/presidency/panama-canal"
    },
    {
      "dato": "El Hay-Bunau-Varilla se firmó el 18 de noviembre de 1903, dos semanas después de la revolución, por John Hay y Bunau-Varilla; EE. UU. actuaría «como si fuera soberano»; 10 millones y 250.000 al año",
      "fuente": "Lester D. Langley, «Hay-Bunau-Varilla Treaty (1903)», Encyclopedia of Latin American History and Culture (Encyclopedia.com)",
      "url": "https://www.encyclopedia.com/humanities/encyclopedias-almanacs-transcripts-and-maps/hay-bunau-varilla-treaty-1903"
    },
    {
      "dato": "El tratado se firmó la tarde del 18 de noviembre de 1903 y Amador y Boyd llegaron a Washington después de la firma",
      "fuente": "Panamá América, «Firma y ratificación del Tratado Hay-Bunau Varilla»",
      "url": "https://panamaamerica.com.pa/opinion/firma-y-ratificacion-del-tratado-hay-bunau-varilla-132129"
    }
  ],
