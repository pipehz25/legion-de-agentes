  "frases": [
    {
      "id": "f1",
      "escena": "fecha",
      "texto": "El 3 de noviembre de 1903, Colombia perdió Panamá. En tres días, y casi sin disparos, un pedazo del país se convirtió en otra república.",
      "cortes": [
        {
          "escena": "separacion",
          "palabra": 9
        }
      ]
    },
    {
      "id": "f2",
      "escena": "tratado",
      "texto": "Dos semanas después, el tratado que le entregó a Estados Unidos la franja del canal lo firmó, en nombre de Panamá, un ingeniero francés.",
      "cortes": [
        {
          "escena": "firma",
          "palabra": 15
        }
      ]
    },
    {
      "id": "f3",
      "escena": "pregunta",
      "texto": "¿Cómo pudo pasar? No fue cosa de un día: fue una cadena de errores, cálculos e intereses que venía de muy atrás.",
      "cortes": [
        {
          "escena": "cadena",
          "palabra": 9
        }
      ]
    },
    {
      "id": "f4",
      "escena": "documentos",
      "texto": "Esta es esa historia, contada con lo que dicen los documentos.",
      "pausa_despues": 2.6,
      "cortes": [
        {
          "escena": "capitulo",
          "palabra": "fin"
        }
      ]
    },
    {
      "id": "f5",
      "escena": "mapa-1821",
      "texto": "Empecemos por el mapa. Panamá se independizó de España en 1821 y se unió por voluntad propia a la Gran Colombia. Desde entonces fue parte de Colombia.",
      "cortes": [
        {
          "escena": "gran-colombia",
          "palabra": 11
        }
      ]
    },
    {
      "id": "f6",
      "escena": "istmo",
      "texto": "Era una de las franjas de tierra más angostas entre el Atlántico y el Pacífico. Cruzarla ahorraba la larguísima vuelta por el sur del continente.",
      "cortes": [
        {
          "escena": "vuelta",
          "palabra": "Cruzarla"
        }
      ]
    },
    {
      "id": "f7",
      "escena": "tren",
      "texto": "En 1855 empezó a funcionar el ferrocarril de Panamá, de una empresa de Nueva York: por fin se cruzaba de océano a océano en tren.",
      "cortes": [
        {
          "escena": "ruta-tren",
          "palabra": 15
        }
      ]
    }
  ]
