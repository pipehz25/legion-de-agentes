    {
      "id": "f2",
      "escena": "quien",
      "texto": "Napoleón Bonaparte, emperador de los franceses, quedó en la memoria como un hombre diminuto.",
      "clave": [
        "diminuto"
      ]
    },
    {
      "id": "f3",
      "escena": "autopsia",
      "texto": "Su autopsia de 1821 dice cinco pies y dos pulgadas: en medidas inglesas, un metro cincuenta y siete.",
      "clave": [
        "autopsia"
      ]
    },
    {
      "id": "f4",
      "escena": "truco",
      "texto": "Pero eran pulgadas francesas, y cada una medía casi dos milímetros más que la inglesa.",
      "clave": [
        "francesas"
      ]
    },
    {
      "id": "f5",
      "escena": "cuenta",
      "texto": "Bien hecha la cuenta, medía un metro con sesenta y ocho, más que el francés promedio.",
      "clave": [
        "sesenta",
        "ocho"
      ],
      "pausa_despues": 0.4
    },
    {
      "id": "f6",
      "escena": "origen",
      "texto": "¿Y de dónde salió el mito? De ese error con las pulgadas,",
      "clave": [
        "mito"
      ]
    },
    {
      "id": "f7",
      "escena": "origen",
      "texto": "de las caricaturas inglesas que lo pintaban enano, y de su apodo cariñoso: el pequeño cabo.",
      "clave": [
        "caricaturas"
      ],
      "pausa_despues": 0.4
    },
    {
      "id": "f8",
      "escena": "cierre",
      "texto": "Napoleón era de estatura normal, y hasta un poco alto para su época.",
      "clave": [
        "normal"
      ]
    }
  ]
