# Entorno de Python de la voz (se recrea con la GUIA)
.venv/

# Dependencias y caches
node_modules/
.hyperframes/
.cache/

# Renders, capturas y audio generado: no viajan por GitHub
videos/*/renders/
videos/*/snapshots/
videos/*/assets/voz/
videos/*/assets/voz-externa/
videos/*/assets/narracion.wav
*.mp4
*.webm

# Voz ya pagada, guardada por texto y voz (se regenera si falta)
.voz-cache/

# Videos largos de YouTube (largo.mjs): imagenes bajadas de Wikimedia Commons (con su ficha de
# licencia) y el trabajo de cada video (lienzos, tramos renderizados, tarjetas, miniatura).
# Cada carpeta de video largo trae ademas su propio .gitignore (solo guion e imagenes propias).
.imagenes-cache/
propios/*/largo/

# Voz grabada: el audio de cada persona y las frases para leer se quedan en la PC
videos/*/grabacion.*
videos/*/para-grabar.txt
