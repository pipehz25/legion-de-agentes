# Copia a .env.local para trabajar en tu PC. En Vercel se ponen en Settings > Environment Variables
# (o con `vercel env add`). Nunca se suben a GitHub ni se pegan en el chat.

# Base de datos Postgres (Neon). La integración de Vercel la crea sola como DATABASE_URL.
# Sin esta variable, en desarrollo la app guarda los datos en .data/mc.json.
DATABASE_URL=

# Secreto para firmar la sesión (32 caracteres o más, al azar).
MC_SECRET=

# Contraseña de cada socio, como hash. Se genera con: npm run password
MC_PASS_SANTIAGO=
MC_PASS_FELIPE=

# Token para que los agentes (Claude en cada PC) escriban el estado del pipeline. 32 caracteres o más.
MC_AGENT_TOKEN=

# Solo en desarrollo: 1 deja entrar sin contraseña si MC_PASS_* está vacío. En producción se ignora.
MC_DEV_OPEN=
